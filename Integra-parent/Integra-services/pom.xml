<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>es.gob.afirma</groupId>
		<artifactId>Integra-parent</artifactId>
		<version>2.3.0_000</version>
	</parent>
	<artifactId>Integra-services</artifactId>
	<packaging>war</packaging>
	<name>Integra-services</name>
	<description>Integra services in a web service</description>

	<dependencies>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-commons</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-ocsp-rfc3161</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-sign-operations</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-utils</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-ws</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-encryption</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.axis2</groupId>
			<artifactId>axis2-kernel</artifactId>
			<version>${version.axis2}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.axis2</groupId>
			<artifactId>axis2-adb</artifactId>
			<version>${version.axis2}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.axis2</groupId>
			<artifactId>axis2-transport-http</artifactId>
			<version>${version.axis2}</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.httpcomponents</groupId>
					<artifactId>httpclient</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.axis2</groupId>
			<artifactId>axis2-transport-local</artifactId>
			<version>${version.axis2}</version>
		</dependency>
		
		<!-- Usaremos para axis2-transport-http la nueva version de httpclient -->
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>${version.httpclient}</version>
		</dependency>
		
		<!-- Scope provided -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>servlet-api</artifactId>
		</dependency>

		<!-- Scope test -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
		</dependency>
	</dependencies>

	<build>
		<resources>
			<resource>
				<directory></directory>
				<includes>
					<include>messages/*</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${project.build.jdk}</source>
					<target>${project.build.jdk}</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
	                <archive>
	                    <manifestEntries>
	                        <Built-By>${user.name}</Built-By>
	                        <Build-Jdk>${project.build.jdk}</Build-Jdk>
	                    </manifestEntries>
	                    <manifestSection>
	                    	<name>Dependencies</name>
	                    	<manifestEntries>
	                    		<Integra-commons>${version.Integra.commons}</Integra-commons>
	                    		<Integra-ocsp-rfc3161>${version.Integra.ocsp.rfc3161}</Integra-ocsp-rfc3161>
	                    		<Integra-sign-operations>${version.Integra.sign.operations}</Integra-sign-operations>
	                    		<Integra-utils>${version.Integra.utils}</Integra-utils>
	                    		<Integra-ws>${version.Integra.ws}</Integra-ws>
	                    		<Integra-encryption>${version.Integra.encryption}</Integra-encryption>
	                    		<axis2-kernel>${version.axis2}</axis2-kernel>
	                    		<axis2-transport-http>${version.axis2}</axis2-transport-http>
	                    		<axis2-transport-local>${version.axis2}</axis2-transport-local>
	                    		<httpclient>${version.httpclient}</httpclient>
	                    		<junit>${version.junit}</junit>
	                    	</manifestEntries>
	                    </manifestSection>
	                </archive>
	            </configuration>
			</plugin>			

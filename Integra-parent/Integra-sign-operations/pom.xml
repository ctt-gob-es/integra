<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>es.gob.afirma</groupId>
    <artifactId>Integra-parent</artifactId>
    <version>2.4.0_000</version>
  </parent>
  <artifactId>Integra-sign-operations</artifactId>
  <name>Integra-sign-operations</name>
  <organization>
		<name>Gobierno de España</name>
	</organization>

	<dependencies>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-commons</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-commons-pdf-bc</artifactId>
		</dependency>
		<dependency>
			<artifactId>Integra-commons-xml</artifactId>
			<groupId>es.gob.afirma</groupId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-ws</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma</groupId>
			<artifactId>Integra-ocsp-rfc3161</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
		</dependency>
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>${version.commons.codec}</version>
		</dependency>
		<dependency> 
			<groupId>org.apache.tika</groupId>
			<artifactId>tika-core</artifactId>
			<version>${version.tika}</version>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcpkix-jdk18on</artifactId>
		</dependency>
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcutil-jdk18on</artifactId>
		</dependency>
		<dependency>
			<groupId>es.gob.afirma.lib</groupId>
			<artifactId>itext-afirma</artifactId>
			<version>${version.afirma.itext}</version>
		</dependency>
		
		<!-- Scope test -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
		</dependency>
	</dependencies>
	

	<build>
		<resources>
			<resource>
				<directory></directory>
				<includes>
					<include>messages/*</include>
				</includes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>*.properties</exclude>
						<exclude>*.jks</exclude>
						<exclude>transformers/**</exclude>
					</excludes>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestSection>
	                    	<name>Dependencies</name>
	                    	<manifestEntries>
							    <Integra-commons>${version.Integra.commons}</Integra-commons>
							    <Integra-commons-pdf-bc>${version.Integra.commons.pdf.bc}</Integra-commons-pdf-bc>
							    <Integra-commons-xml>${version.Integra.commons.xml}</Integra-commons-xml>
							    <Integra-ws>${version.Integra.ws}</Integra-ws>
							    <Integra-ocsp-rfc3161>${version.Integra.ocsp.rfc3161}</Integra-ocsp-rfc3161>
							    <commons-io>${version.commons.io}</commons-io>
							    <commons-codec>${version.commons.codec}</commons-codec>
							    <tika-core>${version.tika}</tika-core>
							    <bcprov-jdk18on>${version.bouncycastle}</bcprov-jdk18on>
							    <bcpkix-jdk18on>${version.bouncycastle}</bcpkix-jdk18on>
							    <bcutil-jdk18on>${version.bouncycastle}</bcutil-jdk18on>
							    <itext-afirma>${version.afirma.itext}</itext-afirma>
							    <junit>${version.junit}</junit>
							</manifestEntries>
	                    </manifestSection>
					</archive>
				</configuration>
				<executions>
					<execution>
						<id>jar-integra-sign-operations</id>
						<goals>
							<goal>jar</goal>
						</goals>
						<phase>package</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>true</skipTests>
        			<argLine>-Dfile.encoding=UTF-8</argLine>
        			<!-- argLine>-Dintegra.config=D:/resources</argLine-->
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>${project.build.jdk}</source>
					<target>${project.build.jdk}</target>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>